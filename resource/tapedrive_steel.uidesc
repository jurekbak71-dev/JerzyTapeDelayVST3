<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
<fonts/>
<colors>
 <color name="Transparent" rgba="#00000000"/>
 <color name="Amber" rgba="#e29a36ff"/>
 <color name="Cream" rgba="#ead8b9ff"/>
 <color name="Black" rgba="#12100eff"/>
 <color name="DarkPlate" rgba="#32302cff"/>
</colors>

<template class="CViewContainer" name="view" origin="0, 0" size="1000, 680" minSize="750, 510" maxSize="1500, 1020" transparent="true">

 <!-- Full vector hardware panel -->
 <view class="HardwarePanel" origin="0, 0" size="1000, 680" mouse-enabled="false"/>

 <!-- Header -->
 <view class="CTextLabel" origin="225, 24" size="550, 42" title="JERZY TAPE DRIVE" font="~ NormalFontVeryBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>
 <view class="CTextLabel" origin="260, 68" size="480, 23" title="ANALOG TAPE DRIVE / WORN TAPE MACHINE" font="~ NormalFontBig" font-color="Amber" transparent="true" text-alignment="center" mouse-enabled="false"/>

 <!-- Explicit UI scale controls -->
 <view class="CTextLabel" origin="765, 25" size="70, 18" title="UI SIZE" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="right" mouse-enabled="false"/>
 <view class="CTextButton" control-tag="Zoom75" origin="842, 20" size="32, 26" title="75" font="~ NormalFont" text-color="Cream" text-color-highlighted="Amber" frame-color="Amber" frame-width="1" round-radius="4" kick-style="true" transparent="true"/>
 <view class="CTextButton" control-tag="Zoom100" origin="878, 20" size="34, 26" title="100" font="~ NormalFont" text-color="Cream" text-color-highlighted="Amber" frame-color="Amber" frame-width="1" round-radius="4" kick-style="true" transparent="true"/>
 <view class="CTextButton" control-tag="Zoom125" origin="916, 20" size="34, 26" title="125" font="~ NormalFont" text-color="Cream" text-color-highlighted="Amber" frame-color="Amber" frame-width="1" round-radius="4" kick-style="true" transparent="true"/>
 <view class="CTextButton" control-tag="Zoom150" origin="954, 20" size="34, 26" title="150" font="~ NormalFont" text-color="Cream" text-color-highlighted="Amber" frame-color="Amber" frame-width="1" round-radius="4" kick-style="true" transparent="true"/>

 <!-- Three proper analog meters -->
 <view class="AnalogMeter" control-tag="InputMeter" origin="70, 135" size="250, 125" mouse-enabled="false"/>
 <view class="AnalogMeter" control-tag="SatMeter" origin="375, 135" size="250, 125" mouse-enabled="false"/>
 <view class="AnalogMeter" control-tag="OutputMeter" origin="680, 135" size="250, 125" mouse-enabled="false"/>
 <view class="CTextLabel" origin="105, 264" size="180, 24" title="INPUT LEVEL" font="~ NormalFontBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>
 <view class="CTextLabel" origin="410, 264" size="180, 24" title="SATURATION" font="~ NormalFontBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>
 <view class="CTextLabel" origin="715, 264" size="180, 24" title="OUTPUT LEVEL" font="~ NormalFontBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>

 <!-- Main row: true chicken-head controls -->
 <view class="ChickenKnob" control-tag="Sat" origin="68, 316" size="150, 150" wheel-inc-value="0.01"/>
 <view class="ChickenKnob" control-tag="Level" origin="298, 316" size="150, 150" wheel-inc-value="0.01"/>
 <view class="ChickenKnob" control-tag="Dry" origin="528, 316" size="150, 150" wheel-inc-value="0.01"/>
 <view class="ChickenKnob" control-tag="WowFlutter" origin="758, 316" size="150, 150" wheel-inc-value="0.01"/>

 <view class="CTextLabel" origin="68, 466" size="150, 24" title="TAPE SAT" font="~ NormalFontBig" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="298, 466" size="150, 24" title="LEVEL" font="~ NormalFontBig" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="528, 466" size="150, 24" title="DRY" font="~ NormalFontBig" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="758, 466" size="150, 24" title="WOW / FLUTTER" font="~ NormalFontBig" font-color="Amber" transparent="true" text-alignment="center"/>

 <view back-color="Black" class="CTextLabel" control-tag="Sat" origin="95, 493" size="96, 22" font="~ NormalFont" font-color="Amber" frame-color="Amber" frame-width="1" text-alignment="center" transparent="false"/>
 <view back-color="Black" class="CTextLabel" control-tag="Level" origin="325, 493" size="96, 22" font="~ NormalFont" font-color="Amber" frame-color="Amber" frame-width="1" text-alignment="center" transparent="false"/>
 <view back-color="Black" class="CTextLabel" control-tag="Dry" origin="555, 493" size="96, 22" font="~ NormalFont" font-color="Amber" frame-color="Amber" frame-width="1" text-alignment="center" transparent="false"/>
 <view back-color="Black" class="CTextLabel" control-tag="WowFlutter" origin="785, 493" size="96, 22" font="~ NormalFont" font-color="Amber" frame-color="Amber" frame-width="1" text-alignment="center" transparent="false"/>

 <!-- Lower hardware deck -->
 <view class="CTextLabel" origin="35, 530" size="490, 28" title="OUTPUT FILTERS" font="~ NormalFontBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>
 <view class="ChickenKnob" control-tag="HPF" origin="45, 565" size="82, 82"/>
 <view class="ChickenKnob" control-tag="HPFRes" origin="155, 565" size="82, 82"/>
 <view class="ChickenKnob" control-tag="LPF" origin="285, 565" size="82, 82"/>
 <view class="ChickenKnob" control-tag="LPFRes" origin="395, 565" size="82, 82"/>
 <view class="CTextLabel" origin="35, 646" size="102, 20" title="HPF FREQ" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="145, 646" size="102, 20" title="HPF RES" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="275, 646" size="102, 20" title="LPF FREQ" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="385, 646" size="102, 20" title="LPF RES" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="center"/>

 <view class="CTextLabel" origin="525, 530" size="225, 28" title="PREAMP" font="~ NormalFontBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>
 <view class="ChickenKnob" control-tag="PreampDrive" origin="535, 558" size="96, 96"/>
 <view class="ThreeWaySwitch" control-tag="PreampMode" origin="655, 562" size="78, 92"/>
 <view class="CTextLabel" origin="530, 646" size="105, 20" title="PREAMP DRIVE" font="~ NormalFont" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="646, 646" size="96, 20" title="MODE" font="~ NormalFont" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="735, 565" size="52, 18" title="TUBE" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="left"/>
 <view class="CTextLabel" origin="735, 595" size="52, 18" title="TRANS" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="left"/>
 <view class="CTextLabel" origin="735, 625" size="52, 18" title="OFF" font="~ NormalFont" font-color="Cream" transparent="true" text-alignment="left"/>

 <view class="CTextLabel" origin="770, 530" size="195, 28" title="TAPE CHARACTER" font="~ NormalFontBig" font-color="Cream" transparent="true" text-alignment="center" mouse-enabled="false"/>
 <view class="ToggleSwitch" control-tag="Gain" origin="785, 562" size="70, 92"/>
 <view class="ThreeWaySwitch" control-tag="Shift" origin="875, 562" size="70, 92"/>
 <view class="CTextLabel" origin="778, 646" size="84, 20" title="GAIN" font="~ NormalFont" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextLabel" origin="868, 646" size="84, 20" title="SHIFT" font="~ NormalFont" font-color="Amber" transparent="true" text-alignment="center"/>
 <view class="CTextButton" control-tag="Bypass" origin="942, 585" size="46, 46" title="BYP" font="~ NormalFont" text-color="Cream" text-color-highlighted="Amber" frame-color="Cream" frame-color-highlighted="Amber" frame-width="2" round-radius="23" kick-style="false" transparent="true"/>
</template>

<control-tags>
 <control-tag name="Sat" tag="300"/><control-tag name="Level" tag="301"/><control-tag name="Dry" tag="302"/>
 <control-tag name="Gain" tag="303"/><control-tag name="Shift" tag="304"/><control-tag name="Bypass" tag="305"/>
 <control-tag name="OutputMeter" tag="306"/><control-tag name="HPF" tag="307"/><control-tag name="HPFRes" tag="308"/>
 <control-tag name="LPF" tag="309"/><control-tag name="LPFRes" tag="310"/><control-tag name="WowFlutter" tag="311"/>
 <control-tag name="InputMeter" tag="312"/><control-tag name="SatMeter" tag="313"/>
 <control-tag name="PreampMode" tag="314"/><control-tag name="PreampDrive" tag="315"/>
 <control-tag name="Zoom75" tag="9001"/><control-tag name="Zoom100" tag="9002"/>
 <control-tag name="Zoom125" tag="9003"/><control-tag name="Zoom150" tag="9004"/>
</control-tags>
<gradients/><variables/>
</vstgui-ui-description>
